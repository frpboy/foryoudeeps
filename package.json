{
  "name": "for-you-deeps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "For You, Deeps - Personal birthday website for Deepthi Jaya's 31st",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
